  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "apps/cli/**/*.ts"]
}
