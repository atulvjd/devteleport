{
  "name": "devteleport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "devteleport": "apps/cli/main.ts"
  },
  "scripts": {
    "test": "node --test tests/core.test.ts tests/security.test.ts",
    "check": "tsc --noEmit && node --check apps/desktop/main.cjs && node --check apps/vscode-extension/extension.cjs",
    "desktop": "npm run build:backend && node scripts/launch-desktop.mjs",
    "package:cli": "node scripts/package.mjs",
    "package:extension": "cd apps/vscode-extension && ../../node_modules/.bin/vsce package --allow-missing-repository --no-dependencies",
    "package:desktop": "npm run build:backend && electron-builder --config apps/desktop/builder.json",
    "test:postgres": "DEVTELEPORT_TEST_POSTGRES=1 node --test tests/postgres.test.ts",
    "test:docker": "DEVTELEPORT_TEST_DOCKER=1 node --test tests/docker.test.ts",
    "test:e2e": "node --test tests/express.e2e.ts",
    "test:desktop": "npm run build:backend && node scripts/desktop-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:full": "node --test tests/full.e2e.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "test:docker:live": "node --test tests/docker-live.test.ts",
    "test:vscode": "node scripts/vscode-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vscode/vsce": "^4.1.0",
    "electron": "^45.2.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "description": "Local-first encrypted development workspace reconstruction",
  "license": "MIT"
}
