{
  "appId": "dev.devteleport.desktop",
  "productName": "DevTeleport",
  "directories": {
    "output": "dist/desktop"
  },
  "files": [
    "apps/desktop/**",
    "package.json",
    "LICENSE"
  ],
  "extraMetadata": {
    "main": "apps/desktop/main.cjs"
  },
  "asar": true,
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "icon": "assets/DevTeleport.icns",
    "notarize": false,
    "hardenedRuntime": false
  },
  "extraResources": [
    {
      "from": "dist/backend",
      "to": "backend"
    }
  ],
  "artifactName": "DevTeleport-${version}-apple-silicon-unsigned.${ext}",
  "protocols": [
    {
      "name": "DevTeleport",
      "schemes": ["devteleport"]
    }
  ],
  "fileAssociations": [
    {
      "ext": "dtp",
      "name": "DevTeleport Snapshot",
      "role": "Viewer"
    }
  ]
}
