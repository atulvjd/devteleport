{
  "name": "devteleport",
  "displayName": "DevTeleport",
  "description": "Capture and restore encrypted local development workspaces",
  "version": "0.2.0",
  "publisher": "devteleport-local",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onView:devteleport.workspace",
    "workspaceContains:.vscode/devteleport-session.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devteleport.inspect",
        "title": "DevTeleport: Inspect Workspace"
      },
      {
        "command": "devteleport.capture",
        "title": "DevTeleport: Capture Workspace"
      },
      {
        "command": "devteleport.restore",
        "title": "DevTeleport: Restore Workspace"
      },
      {
        "command": "devteleport.verify",
        "title": "DevTeleport: Verify Workspace"
      },
      {
        "command": "devteleport.history",
        "title": "DevTeleport: View Snapshot History"
      },
      {
        "command": "devteleport.openDesktop",
        "title": "DevTeleport: Open Desktop Application"
      },
      {
        "command": "devteleport.cancel",
        "title": "DevTeleport: Cancel Current Operation"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devteleport",
          "title": "DevTeleport",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "devteleport": [
        {
          "id": "devteleport.workspace",
          "name": "Workspace Transport"
        }
      ]
    },
    "configuration": {
      "title": "DevTeleport",
      "properties": {
        "devteleport.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Absolute path to a Node 24+ executable",
          "scope": "machine",
          "restricted": true
        },
        "devteleport.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to installed DevTeleport apps/cli/main.js (or main.ts in a source checkout)",
          "scope": "machine",
          "restricted": true
        }
      }
    }
  },
  "license": "MIT",
  "files": [
    "extension.cjs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Capture and saved editor restoration require workspace trust; inspection and explicit file restoration remain available."
    }
  }
}
